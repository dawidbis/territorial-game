{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ]
  },
  "ConnectionStrings": {
    "Meta": "Data Source=App_Data/territorial-dev.db"
  },
  "Match": {
    "Allocator": "LocalProcess",
    "GameServerPath": "../../../gameserver/build/windows-msvc/RelWithDebInfo/gameserver.exe",
    "MapsRoot": "../../../maps",
    "GameServerPort": 5101,
    "GameServerPortCount": 8,
    "MatchIdleSeconds": 20,
    "FillWithBots": false,
    "MatchWebSocketBaseUrl": "wss://localhost:4200/ws/match"
  }
}
