<Project>

  <!-- Central Package Management.
       Wersje żyją WYŁĄCZNIE tutaj. W .csproj: <PackageReference Include="X" /> bez Version.
       Wpis <PackageVersion> bez odpowiadającego <PackageReference> jest bezczynny —
       dlatego katalog może wyprzedzać faktyczne użycie. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pozwala podnieść wersję zależności PRZECHODNIEJ bez dodawania jej
         jako fałszywej referencji bezpośredniej. Używane niżej dla CVE. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>

  <ItemGroup Label="Wymuszone podniesienia (CVE)">
    <!-- GHSA-v5pm-xwqc-g5wc (high): Microsoft.OpenApi <= 2.7.4.
         Microsoft.AspNetCore.OpenApi 10.0.10 ciągnie 2.0.0. Pierwsza łatka: 2.7.5.
         Do usunięcia, gdy ASP.NET podniesie zależność u siebie. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />

    <!-- GHSA-2m69-gcr7-jv3q (high): natywny SQLite w SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11.
         Microsoft.EntityFrameworkCore.Sqlite ciąga 2.1.11 przez bundle_e_sqlite3.
         Paczka zawiera wyłącznie binaria natywne, bez API zarządzanego, więc podbicie
         łatki jest bezpieczne. Rodziny SQLitePCLRaw NIE ruszamy do 3.x — to major,
         a Microsoft.Data.Sqlite jest zbudowany pod 2.x. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup Label="Warstwa aplikacji">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Persystencja">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Testy">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <!-- FakeTimeProvider — podstawiany pod TimeProvider w testach use case'ów. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
  </ItemGroup>

</Project>
